APP_NAME="Torino Moda Style"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_CURRENCY=OMR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phoenix ERP integration
PHOENIX_USE_MOCK=true
PHOENIX_API_BASE_URL=https://phoenix.example.com
PHOENIX_API_KEY=
PHOENIX_API_USERNAME=
PHOENIX_API_PASSWORD=
PHOENIX_TIMEOUT=30
PHOENIX_RETRY_TIMES=3

# Payments (mock default; set PAYMENT_PROVIDER=thawani for Thawani UAT)
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=mock-webhook-secret

# Inventory admin thresholds
LOW_STOCK_THRESHOLD=5

# Thawani (UAT defaults — switch URLs/keys for production)
# THAWANI_SECRET_KEY=
# THAWANI_PUBLISHABLE_KEY=
# THAWANI_WEBHOOK_SECRET=
# THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1
# THAWANI_CHECKOUT_BASE_URL=https://uatcheckout.thawani.om
# Placeholder routes: GET /payments/thawani/success and /payments/thawani/cancel (see routes/web.php)
# THAWANI_SUCCESS_URL="${APP_URL}/payments/thawani/success"
# THAWANI_CANCEL_URL="${APP_URL}/payments/thawani/cancel"
# THAWANI_EXPIRY_MINUTES=30

# Mobile deep links used after Thawani browser return (custom URL scheme)
MOBILE_PAYMENT_SUCCESS_URL=torinomodastyle://payment/success
MOBILE_PAYMENT_CANCEL_URL=torinomodastyle://payment/cancel

# Legal content placeholders (configure before public release)
LEGAL_COMPANY_NAME="[Company legal name — configure before release]"
LEGAL_CONTACT_EMAIL="[contact@example.com — configure before release]"
LEGAL_CONTACT_PHONE="[+00000000000 — configure before release]"
LEGAL_CONTACT_ADDRESS="[Business address — configure before release]"
LEGAL_LAST_UPDATED=2026-07-13

# --- Production / staging example (do not commit real secrets) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.example.com
# PAYMENT_PROVIDER=thawani
# THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1
# THAWANI_CHECKOUT_BASE_URL=https://uatcheckout.thawani.om
# THAWANI_PUBLISHABLE_KEY=
# THAWANI_SECRET_KEY=
# THAWANI_WEBHOOK_SECRET=
# THAWANI_SUCCESS_URL=https://api.example.com/payments/thawani/success
# THAWANI_CANCEL_URL=https://api.example.com/payments/thawani/cancel
# DB_CONNECTION=mysql
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
