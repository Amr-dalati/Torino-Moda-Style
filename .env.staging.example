# Staging environment template — copy to server as `.env` (never commit real secrets).
# Example: cp .env.staging.example /path/to/app/.env

APP_NAME="Torino Moda Style"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_CURRENCY=OMR

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# Database — use dedicated staging database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=torino_moda_style_staging
DB_USERNAME=staging_user
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local

# Payments — Thawani UAT
PAYMENT_PROVIDER=thawani
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1
THAWANI_CHECKOUT_BASE_URL=https://uatcheckout.thawani.om
THAWANI_PUBLISHABLE_KEY=
THAWANI_SECRET_KEY=
THAWANI_WEBHOOK_SECRET=
THAWANI_SUCCESS_URL=https://staging-api.example.com/payments/thawani/success
THAWANI_CANCEL_URL=https://staging-api.example.com/payments/thawani/cancel
THAWANI_EXPIRY_MINUTES=30

MOBILE_PAYMENT_SUCCESS_URL=torinomodastyle://payment/success
MOBILE_PAYMENT_CANCEL_URL=torinomodastyle://payment/cancel

# Inventory
LOW_STOCK_THRESHOLD=5

# Phoenix — keep mock until live ERP credentials are approved
PHOENIX_USE_MOCK=true
PHOENIX_API_BASE_URL=https://phoenix.example.com
PHOENIX_API_KEY=

# Legal placeholders — configure before public release
LEGAL_COMPANY_NAME="[Company legal name — configure before release]"
LEGAL_CONTACT_EMAIL="[contact@example.com — configure before release]"
LEGAL_CONTACT_PHONE="[+00000000000 — configure before release]"
LEGAL_CONTACT_ADDRESS="[Business address — configure before release]"
LEGAL_LAST_UPDATED=2026-07-13

# Staging seed credentials (used only by StagingSeeder — never commit real values)
STAGING_CUSTOMER_PHONE=
STAGING_CUSTOMER_PASSWORD=
STAGING_ADMIN_EMAIL=admin@torinomodastyle.com
STAGING_ADMIN_PASSWORD=

# Optional backend error monitoring
# SENTRY_LARAVEL_DSN=
